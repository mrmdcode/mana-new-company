# مسیر فایل دیتابیس SQLite (پیش‌فرض: ./data/app.db)
# DB_PATH=./data/app.db

# رمز عبور اولیه پنل مدیریت (اگر تنظیم نشود، یک رمز تصادفی ساخته و در لاگ سرور چاپ می‌شود)
# ADMIN_DEFAULT_PASSWORD=

# کلید امضای نشست ورود به پنل مدیریت (اگر تنظیم نشود، به‌صورت خودکار ساخته و در دیتابیس ذخیره می‌شود)
# ADMIN_SESSION_SECRET=

# آدرس API مستقل وبلاگ (در صورت نبود، محتوای نمونه نمایش داده می‌شود)
# BLOG_API_URL=

# کلید API کاوه‌نگار برای ارسال پیامک خودکار (می‌توانید به‌جای این، از پنل تنظیمات هم وارد کنید؛
# مقدار ذخیره‌شده در پنل همیشه بر این متغیر اولویت دارد)
# KAVENEGAR_API_KEY=

# شماره خط ارسال‌کننده کاوه‌نگار (اختیاری؛ خالی بماند تا از خط پیش‌فرض حساب استفاده شود)
# KAVENEGAR_SENDER=

# کد تأیید مالکیت گوگل سرچ کنسول (Settings > Ownership verification > HTML tag،
# فقط مقدار content را اینجا بگذارید، بدون خود تگ meta)
# توجه: چون این مقدار در متادیتای استاتیک استفاده می‌شود، هنگام تغییرش با داکر
# باید ایمیج را دوباره بسازید: docker compose up -d --build (صرفاً ری‌استارت کافی نیست)
# GOOGLE_SITE_VERIFICATION=
